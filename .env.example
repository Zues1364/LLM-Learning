# Core model/runtime
APP_ENV=development
APP_DATA_DIR=data
GEMINI_API_KEY=
GOOGLE_API_KEY=
MCP_SERVER_URL=http://127.0.0.1:8000
MCP_REQUIRE_API_KEY=false
MCP_API_KEY=change-me-if-mcp-requires-auth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=rag-files
STRUCTURED_TKB_ENABLED=true
MAX_TRANSCRIPT_UPLOAD_MB=50
MAX_RESOURCE_UPLOAD_MB=100
MAX_BATCH_UPLOAD_FILES=25

# Frontend/backend origins for cookie-auth requests
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:9000,http://localhost:9000
VITE_API_BASE=http://127.0.0.1:9000

# App Google sign-in session
APP_SESSION_SECRET=change-me-before-production
APP_SESSION_COOKIE_NAME=rag_cosmic_session
APP_SESSION_TTL_DAYS=7
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=lax
APP_OAUTH_REDIRECT_URI=http://127.0.0.1:9000/api/auth/google/callback
APP_GOOGLE_AUTH_SCOPE=openid email profile

# Gmail mail-update OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:9000/api/mail/connect/callback
MAIL_GMAIL_QUERY=newer_than:7d
MAIL_POLL_MINUTES=5
MAIL_RETENTION_DAYS=7
MAIL_TRUSTED_DOMAINS=uet.edu.vn,vnu.edu.vn
MAIL_INTENT_CLASSIFIER_MODE=hybrid
MAIL_INTENT_LLM_MODEL=gemini-2.5-flash
MAIL_INTENT_LLM_THRESHOLD=0.70
MAIL_RELEVANCE_KEYWORDS=
MAIL_SCHEDULE_TOKENS=
MAIL_REGISTRATION_TOKENS=
MAIL_NEGATIVE_TOKENS=
MAIL_OAUTH_STATE_TTL_SECONDS=600

# Request/tool timeouts, seconds. Use <=0 to disable timeout where supported.
ASK_CONSULT_ADVISOR_TIMEOUT_SEC=300
ASK_RETRIEVE_CHUNKS_TIMEOUT_SEC=45
ASK_CONSULT_ADVISOR_TIMEOUT_SEC_TRANSCRIPT=900

# Optional runtime logging
LOG_CHUNK_LOADING=false
PGVECTOR_EMBEDDING_DIM=1024
EMBEDDER_UNLOAD_AFTER_SECONDS=300
PDF_PROCESSING_MODE=text_first
MCP_STARTUP_VECTOR_INIT=lazy
MCP_EAGER_LOAD_RESOURCES=false
